FROM node:24-alpine AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
RUN apk add --no-cache openssl libc6-compat ca-certificates
WORKDIR /app

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM dependencies AS builder
ARG DB_TYPE=postgres
COPY tsconfig.base.json turbo.json ./
COPY apps/api apps/api
RUN DB_TYPE=${DB_TYPE:-postgres} pnpm db:generate \
    && pnpm --filter api build

FROM base AS production-dependencies
ARG DB_TYPE=postgres
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/prisma.config.ts
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod --filter "api..." \
    && DB_TYPE=${DB_TYPE:-postgres} pnpm db:generate \
    && find /app/node_modules -type f \( -name "*.map" -o -name "*.d.ts" -o -name "*.ts.buildinfo" -o -name "*.md" \) -delete \
    && find /app/node_modules -type d \( -name "test" -o -name "tests" -o -name "__tests__" -o -name "docs" -o -name "example" -o -name "examples" \) -exec rm -rf {} + 2>/dev/null || true

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3100
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat ca-certificates \
    && addgroup -g 1001 -S nodeapp \
    && adduser -u 1001 -S nodeapp -G nodeapp \
    && mkdir -p /app/apps/api/uploads \
    && chown -R nodeapp:nodeapp /app

COPY --from=production-dependencies --chown=nodeapp:nodeapp /app/node_modules ./node_modules
COPY --from=production-dependencies --chown=nodeapp:nodeapp /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=production-dependencies --chown=nodeapp:nodeapp /app/apps/api/prisma ./apps/api/prisma
COPY --from=production-dependencies --chown=nodeapp:nodeapp /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=production-dependencies --chown=nodeapp:nodeapp /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=nodeapp:nodeapp /app/apps/api/dist ./apps/api/dist
COPY --chmod=755 docker/entrypoint-api.sh /usr/local/bin/entrypoint-api

USER nodeapp
WORKDIR /app/apps/api
EXPOSE 3100

ENTRYPOINT ["entrypoint-api"]
CMD ["node", "dist/src/main.js"]
