{
  "name": "zhuostack",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "description": "Production-oriented NestJS + Next.js full-stack monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:deploy": "pnpm --filter api build && pnpm --filter web build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter api test:e2e",
    "test:ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "openapi:export": "pnpm --filter api openapi:export",
    "codegen": "pnpm --filter web codegen",
    "contract:sync": "pnpm openapi:export && pnpm codegen",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed": "pnpm --filter api db:seed",
    "db:setup": "pnpm --filter api db:setup",
    "db:studio": "pnpm --filter api db:studio",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:verify": "pnpm --filter api db:verify",
    "db:baseline": "pnpm --filter api db:baseline",
    "ops": "bash scripts/deploy.sh",
    "docker:up": "bash scripts/deploy.sh docker up",
    "docker:down": "bash scripts/deploy.sh docker down",
    "release": "bash scripts/deploy.sh pack interactive",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "fastify@5.11.3": "5.12.7"
    }
  }
}
