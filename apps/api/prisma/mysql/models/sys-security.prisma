model SysIpRule {
  id        String    @id @default(cuid())
  ip        String    @unique(length: 100)
  type      String    @default("BLACKLIST") @db.VarChar(20)
  reason    String?   @db.VarChar(255)
  expiredAt DateTime?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status])
  @@map("sys_ip_rules")
}

model SysThrottleRule {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  path         String   @db.VarChar(191)
  method       String   @default("ALL") @db.VarChar(10)
  limit        Int      @default(60)
  ttl          Int      @default(60)
  dimension    String   @default("IP") @db.VarChar(20)
  autoBlock    Boolean  @default(false)
  blockMinutes Int      @default(15)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([path, method])
  @@map("sys_throttle_rules")
}
