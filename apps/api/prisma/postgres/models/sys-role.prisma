model SysRole {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sort      Int       @default(0)
  status    Status    @default(ACTIVE)
  dataScope DataScope @default(ALL)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  menus     SysMenu[]
  dataDepts SysDept[]

  @@map("sys_role")
}
