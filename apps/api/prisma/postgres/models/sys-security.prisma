model SysIpRule {
  id        String    @id @default(cuid())
  ip        String    @unique
  type      String    @default("BLACKLIST")
  reason    String?
  expiredAt DateTime?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status])
  @@map("sys_ip_rules")
}

model SysThrottleRule {
  id           String   @id @default(cuid())
  name         String
  path         String
  method       String   @default("ALL")
  limit        Int      @default(60)
  ttl          Int      @default(60)
  dimension    String   @default("IP")
  autoBlock    Boolean  @default(false)
  blockMinutes Int      @default(15)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([path, method])
  @@map("sys_throttle_rules")
}
