{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "description": "ZhuoStack Next.js web application",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
