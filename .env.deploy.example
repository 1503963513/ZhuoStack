# ==============================================================================
# ZhuoStack 生产环境部署配置模板 (.env.deploy.example)
#
# 使用指引：
#   1. 复制本文件为 .env.deploy:
#        cp .env.deploy.example .env.deploy
#   2. 执行一键生成/部署命令:
#        bash scripts/deploy.sh docker up
#      （脚本会自动检查并将默认弱密钥自动替换为高强度随机密文）
#
# 快速检查清单（新人部署必看）：
#   [ ] 端口检查：若服务器 80/443 已被宿主机 Nginx 占用，需修改 WEB_PORT/WEB_TLS_PORT
#   [ ] 协议检查：纯 IP / HTTP 访问必须保持 COOKIE_SECURE=false，否则浏览器会拦截登录 Cookie！
#   [ ] 跨域检查：若配置了外部域名，修改 CORS_ORIGIN 为你的前端真实域名
#   [ ] 数据库选型：默认 postgres，如需使用 MySQL 将 DB_TYPE 改为 mysql
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础编排与容器端口配置
# ------------------------------------------------------------------------------
# Docker Compose 项目名称前缀，会作为容器名前缀（如 zhuostack-web-1）
COMPOSE_PROJECT_NAME=zhuostack

# 镜像前缀与版本标签（离线部署包会自动注入当前构建版本）
APP_IMAGE_PREFIX=zhuostack
APP_VERSION=latest

# 系统时区设置
TZ=Asia/Shanghai

# 前端 Web 对外暴露的 HTTP 端口（默认 80；若宿主机 80 端口已被占用，可改为 3000、8080 等）
WEB_PORT=80

# 前端 Web 对外暴露的 HTTPS/TLS 端口（默认 443；若 443 已被占用，可改为 3443、8443 等）
WEB_TLS_PORT=443

# SSL/TLS 证书目录（可选）
# 若需要容器自带 Nginx 启用 HTTPS，将 tls.crt 和 tls.key 放入此目录；
# 若使用外部云厂商负载均衡器或宝塔/宿主机 Nginx 统一终止 HTTPS，可忽略此项。
TLS_CERT_DIR=./docker/certs

# 后端 API 容器对外暴露的调试端口（绑定在 127.0.0.1，外部请求由前端 Nginx 内部反代 /api/，通常保持 3100 即可）
API_PORT=3100


# ------------------------------------------------------------------------------
# 2. 数据库与缓存配置
# ------------------------------------------------------------------------------
# 数据库类型选择：postgres 或 mysql（必须与下方 DATABASE_URL 协议对应）
DB_TYPE=postgres

# 数据库连接字符串（内置容器连接示例：db 即为容器内网络服务名）
#   - PostgreSQL 格式: postgresql://<USER>:<PASS>@db:5432/<DB_NAME>
#   - MySQL 格式:      mysql://<USER>:<PASS>@db:3306/<DB_NAME>
DATABASE_URL=postgresql://zhuostack:zhuostack123@db:5432/zhuostack

# 启动时是否自动运行已审核的 Prisma 数据库迁移（生产部署必须设为 true）
DB_MIGRATE_ON_START=true

# 首次部署时是否自动填充种子数据（生成默认管理员 admin@example.com / admin123 及初始字典菜单）
DB_SEED_ON_START=true

# ------------------------------------------------------------------------------
# [进阶场景] 外部已有数据库与 Redis 模式：
# 若服务器上已安装现成的 MySQL/PostgreSQL 或使用云 RDS，不想在容器中再启动 db 和 redis，
# 请取消下方 3 行注释并填写真实连接（宿主机本机可用 host.docker.internal 穿透访问）：
# ------------------------------------------------------------------------------
# EXTERNAL_DB=true
# DATABASE_URL=mysql://zhuostack:password123@host.docker.internal:3306/zhuostack
# REDIS_URL=redis://:redispassword@host.docker.internal:6379

# PostgreSQL 容器初始化账号密码（仅在 DB_TYPE=postgres 且使用内置容器时生效）
POSTGRES_USER=zhuostack
POSTGRES_PASSWORD=zhuostack123
POSTGRES_DB=zhuostack

# MySQL 容器初始化账号密码（仅在 DB_TYPE=mysql 且使用内置容器时生效）
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=zhuostack
MYSQL_USER=zhuostack
MYSQL_PASSWORD=zhuostack123

# Redis 密码（首次执行部署脚本会自动为你生成 32 位高强度随机密码）
REDIS_PASSWORD=CHANGE_ME_THE_DEPLOY_SCRIPT_WILL_GENERATE_A_SECURE_SECRET
REDIS_REQUIRED=true


# ------------------------------------------------------------------------------
# 3. 身份认证与安全防护配置（重要）
# ------------------------------------------------------------------------------
# JWT 签名密钥（必须保持高强度；首次部署脚本会自动生成 64 位随机密文，切勿泄漏）
JWT_SECRET=CHANGE_ME_THE_DEPLOY_SCRIPT_WILL_GENERATE_A_SECURE_SECRET

# JWT 登录会话有效期（格式示例：30m / 8h / 7d）
JWT_EXPIRES_IN=8h

# JWT 发行者与受众标识
JWT_ISSUER=zhuostack-api
JWT_AUDIENCE=zhuostack-web

# 运行环境模式：production
NODE_ENV=production

# Cookie 安全传输标记：
#   - false: 适用于纯 IP 访问或未配置 SSL 证书的纯 HTTP 站点（如 http://IP:3000）。
#            注意：如果使用纯 HTTP 却设为 true，主流浏览器（Chrome/Safari）会拦截丢弃 Cookie，导致登录后报 401！
#   - true:  适用于已配置合法 HTTPS 域名证书的站点（强烈推荐生产上线启用）。
COOKIE_SECURE=false

# 后端监听端口（容器内部端口，无需修改）
PORT=3100

# 跨域资源共享（CORS）允许的源：
#   - 填写前端对外访问的完整根域名，如 https://admin.yourdomain.com
#   - 本地 IP 测试可填: http://localhost:3000 或具体 IP 地址
CORS_ORIGIN=https://localhost

# 是否开启 Swagger 在线 API 文档（生产环境建议设为 false，排查调试时可设为 true 访问 /api/docs）
SWAGGER_ENABLED=false

# API 请求限流防护（默认：每个 IP 在 60 秒内最多发起 100 次请求）
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 仅信任反向代理所在的网段 IP（严禁在生产环境配置为 true/*/all）
TRUST_PROXY=loopback,linklocal,uniquelocal


# ------------------------------------------------------------------------------
# 4. 容器硬件资源与日志配额（按服务器实际硬件规格调整）
# ------------------------------------------------------------------------------
# 数据库容器资源上限
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0

# Redis 容器资源上限
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# 后端 API 容器资源上限
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0

# 前端 Web 容器资源上限
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5

# Docker 单个容器日志文件最大容量与滚动备份数量（防止长时间运行打满磁盘）
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5


# ------------------------------------------------------------------------------
# 5. AI 大模型能力模块配置（可选）
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096


# ------------------------------------------------------------------------------
# 6. 文件存储配置（支持本地存储 local、阿里云 OSS aliyun、腾讯云 COS tencent）
# ------------------------------------------------------------------------------
# 存储驱动选择：local | aliyun | tencent
FILE_STORAGE_TYPE=local

# 宿主机物理存储目录（local 模式下挂载到宿主机真实路径，重新部署绝对不丢文件，方便备份）
# 默认存放在部署目录下的 ./uploads，也可以指定绝对路径如 /data/zhuostack/uploads
HOST_UPLOAD_DIR=./uploads

# 容器内部文件存储路径与访问前缀（通常保持默认即可）
FILE_STORAGE_PATH=/app/apps/api/uploads
FILE_URL_PREFIX=/files
FILE_OBJECT_PREFIX=
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv,application/zip,video/mp4,video/webm,audio/mpeg

# ------------------------------------------------------------------------------
# 阿里云 OSS 配置（仅在 FILE_STORAGE_TYPE=aliyun 时生效并必填）
# ------------------------------------------------------------------------------
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 腾讯云 COS 配置（仅在 FILE_STORAGE_TYPE=tencent 时生效并必填，Bucket 需含 APPID）
# ------------------------------------------------------------------------------
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_PUBLIC_URL=
